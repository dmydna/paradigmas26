-- Enunciado --

data AB a = Nil | Bin (AB a) a (AB a)

elemAB :: Eq a => a -> AB a -> Bool
{PO} elemAB _ Nil = False
{P1} elemAB x (Bin i r d) = (x == r) || (elemAB x i) || (elemAB x d)

mapAB :: (a -> b) -> AB a -> AB b
{M0} mapAB _ Nil = Nil
{M1} mapAB f (Bin i r d) = Bin (mapAB f i) (f r) (mapAB f d)

{CONGR* == } ∀x::a.∀y::a.∀f::a->b. x==y => f x == f y

Demostrar
∀t :: AB a . ∀x :: a.  ∀f :: a -> b. elemAB x t => elemAB (f x)(mapAB f t)

-- Solucion --

Defino P(t) = ∀x :: a.  ∀f :: a -> b. elemAB x t => elemAB (f x)(mapAB f t)

Por induccion estructural sobre (AB a) si vale:
 1. P(Nil)
 2. ∀ i, d:: AB a . r :: a . P(i) ∧ P(d) => P(Bin i r d)
Entonces vale. ∀ t :: AB a . P(t)

1. Caso Base t = Nil
‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
elemAB (Nil) t => elemAB (f x)(mapAB f (Nil))
{P0}   = false => elemAB (f x)(mapAB f (Nil))
{bool} = True

2. Paso Inductivo t = Bin i r d
‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
donde P(i) ∧ P(d) es la HI:
      P(i) :=  ∀f :: a -> b. elemAB x i => elemAB (f x)(mapAB f i)
      P(d) :=  ∀f :: a -> b. elemAB x d => elemAB (f x)(mapAB f d)

elemAB x (Bin i r d) => elemAB (f x)(mapAB f (Bin i r d))
{P1}  (x == r) || (elemAB x i) || (elemAB x d)
{M1}           => (f x == f r) || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)

:: Por lema de generaion de booleanos (x == r):
      1. (x == r) := True
      2. (x == r) := False

Caso 1. (x == r) := True
‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
True || (elemAB x i) || (elemAB x d)  ={bool} True
          => (f x == f r) || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
          => (f x == f r) || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
{CONGR*}  => (x == r)     || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
{bool}    => True


Caso 2. (x == r) := False
‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
False || (elemAB x i) || (elemAB x d)
    => False || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)

   :: Por lema de generaion de boleanos
       1. (elemAB x i) = True
       2. (elemAB x i) = False

    Caso 1.  (elemAB x i) := True
    ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
    True || (elemAB x d) ={bool} True
                   =>  elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
                   =>  (f x == f r) || elemAB (f x) (mapAB f i) || elemAB (f x) (mapAB f d)
    {HI} {CONGR*}  =>  True || True || True


    Caso 2.  (elemAB x i) := False
    ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
    False || (elemAB x d) = (elemAB x d)
                   =>  elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
                   =>  (f x == f r) || elemAB (f x) (mapAB f i) || elemAB (f x) (mapAB f d)
    {HI} {CONGR*}  =>  True || True || True
