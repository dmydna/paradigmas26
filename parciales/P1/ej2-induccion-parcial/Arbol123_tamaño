data Arbol123 a b = Hoja a  | Dos b (Arbol123 a b) (Arbol123 a b)
                            | Tras b b (Arbol123 a b) (Arbol123 a b) (Arbol123 a b)

     const :: a -> b -> a
{C}  const = (\x -> \y -> x)

     tamaño :: Arbol123 a b -> Int
{AO} tamaño (Hoja v) = 1
{A1} tamaño (Dos x i d) = 1 + tamaño i + tamaño d
{A2} tamaño (Tres x y i m d) = 2 + tamaño i + tamaño m + tamaño d

     truncar :: a -> Arbol123 a b ->  Int -> Arbol123 a b
{T0} truncar c (Hoja v) = const (Hoja c)
{T1} truncar c (Dos x i d) =
        (\n -> of n < 1 then Hoja c else Dos x (truncar c i (n-1)) (truncar c d (n-1)))
{T2} truncar c (Tres x y i m d) =
        (\n -> of n < 1 then Hoja c else Tres x y (truncar c i (n-1)) (truncar c m (n-1))(truncar c d (n-1)) )

Demostrar
∀t :: Arbol123 a b . ∀c :: a.  ∀n :: Int.  tamaño(truncar c t n) <= tamaño t

{LEMA} ∀t :: Arbol123 a b . 1 <= tamaño t.

-- Solucion --

Defino P(t) =  ∀c :: a.  ∀n :: Int.  tamaño(truncar c t n) <= tamaño t

Por induccion estructural sobre (Arbol123 a b) si vale:
  1. P(Hoja a)
  2. ∀ r, d:: Arbol123 a b . i :: b . P(r) ∧ P(d) ⇒ P(Dos i r d)
  3. ∀ r, d:: Arbol123 a b . i :: b . P(r) ∧ P(d) ⇒ P(Tres i  i  r d)
Entonces vale. ∀ t :: Arbol123 a b . P(t)


1. Caso Base
‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
P(Hoja a) =  tamaño(truncar c (Hoja a) n) <= tamaño (Hoja a)
{C}       =  tamaño(Hoja c)         <= tamaño (Hoja a)
{LEMA}    =  1 == 1

2. Caso Inductivo t=(Dos x r d)
‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
donde P(r) ∧ P(d) es la HI:
 1. P(r) = tamaño(truncar c r n) <= tamaño r
 2. P(d) = tamaño(truncar c d n) <= tamaño d

tamaño(truncar c (Dos x r d) n) <= tamaño (Dos x r d)
    = tamaño((\n -> of n < 1 then Hoja c else Dos x (truncar c i (n-1)) (truncar c d (n-1)))) <= tamaño (Dos x r d)
{b} = tamaño (if n < 1 then Hoja c else Dos x (truncar c i (n-1)) (truncar c d (n-1)) ) <= tamaño (Dos x r d)

   Caso if. (n-1 =  True)
   ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
   tamaño (if True then Hoja c else Dos x (truncar c i (n-1)) (truncar c d (n-1)))
   {ifThenElse}         = tamaño (Hoja c)
   {A0}                 = 1

   Caso else (n < 1 = False)
   ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
   tamaño (if False then (Hoja c) else Dos x (truncar c i (n-1)) (truncar c d (n-1)))
   {ifThenElse}       = tamaño(Dos x (truncar c i (n-1)) (truncar c d (n-1)))
   {A1}               = 1 + tamaño (truncar c i (n-1)) + tamaño (truncar c d (n-1))

vemos que:
  1. tamaño (truncar c i (n-1)) <= {h1} tamaño i
  2. tamaño (truncar c d (n-1)) <= {h1} tamaño d

Luego:
   {hi} <= 1 + tamaño i + tamaño d = {A1} = tamaño (Dos x i d)
