-- Enunciado --

data AB a = Nil | Bin (AB a) a (AB a)

elemAB :: Eq a => a -> AB a -> Bool 
{PO} elemAB _ Nil = False
{P1} elemAB x (Bin i r d) = (x == r) || (elemAB x d)

mapAB :: (a -> b) -> AB a -> AB b
{M0} mapAB _ Nil = Nil
{M1} mapAB f (Bin i r d) = Bin (mapAB f i) (mapAB f d)


Demostrar 
∀t :: AB a . ∀x :: a.  ∀f :: a -> b. elemAB x t ⇒ elemAB (f x)(mapAB f t) 

Defino P(t) = ∀x :: a.  ∀f :: a -> b. elemAB x t ⇒ elemAB (f x)(mapAB f t) 


-- Solucion

Por induccion estructural sobre (AB a) si vale:
1. P(Nil)
2. ∀ i, d:: AB a . r :: a . P(i) ∧ P(d) ⇒ P(Bin i r d)
Entonces vale. ∀ t :: AB a . P(t) 

1. Caso Base
--------------
P(Nil) = elemAB (Nil) t ⇒ elemAB (f x)(mapAB f (Nil))
{P0}   = false          ⇒ elemAB (f x)(mapAB f (Nil))
{bool} = true

2. Caso Inductivo
-----------------
∀ i, d:: AB a . r :: a . P(i) ∧ P(d) ⇒ P(Bin i r d)
  H1 :=  P(i) ∧ P(d)  
  1. P(i) :=  elemAB x i ⇒ elemAB (f x)(mapAB f i) 
  2. P(d) :=  elemAB x d ⇒ elemAB (f x)(mapAB f d) 


P(Bin i r d) = elemAB x (Bin i r d) ⇒ elemAB (f x)(mapAB f (Bin i r d))


Antecedente:
-----------
elemAB x (Bin i r d)
{P1}  =  (x == r) || (elemAB x i) || (elemAB x d)

:: Por lema de generacion de Booleanos (x == r):
      1. (x == r) := true
      2. (x == r) := false


Concecuente:
------------
elemAB (f x)(mapAB f (Bin i r d)) 
{M1}  = elemAB (f x) (Bin (mapAB f i) (f r) (mapAB f d))
      = (f x == f r) || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)


Juntamos antecendente y concecuente: 

(x == r) || (elemAB x i) || (elemAB x d)
 ⇒ (f x == f r) | elemAB (f x)(mapAB f i) |elemAB (f x)(mapAB f d)

Caso 1. (x == r) := true
-------------------------
true || (elemAB x i) || (elemAB x d) = true 
               ⇒ (f x == f r) || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
{CONGRUENCIA}  ⇒ (x == r)     || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)
               ⇒ true

Caso 1. (x == r) := false
--------------------------
false || (elemAB x i) || (elemAB x d)
    ⇒ false || elemAB (f x)(mapAB f i) || elemAB (f x)(mapAB f d)

   :: Por lema de generacion de boleanos 
       1. (elemAB x i) = true
       2. (elemAB x i) = false

    Caso 1.  (elemAB x i) := true
    -----------------------------
    true || (elemAB x d) = true
                   ⇒  elemAB (f x)(mapAB f i) | elemAB (f x)(mapAB f d)
                   ⇒  (f x == f r) || elemAB (f x) (mapAB f i) || elemAB (f x) (mapAB f d)
     {HI} {CONGR*} ⇒  True| True | True


    Caso 2.  (elemAB x i) := false
    ------------------------------
    false || (elemAB x d) = (elemAB x d)
                   ⇒  elemAB (f x)(mapAB f i) | elemAB (f x)(mapAB f d)
                   ⇒  (f x == f r) || elemAB (f x) (mapAB f i) || elemAB (f x) (mapAB f d)
     {HI} {CONGR*} ⇒  True| True | True



